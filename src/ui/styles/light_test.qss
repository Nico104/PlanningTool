/* ---- TerminCard ---- */
QFrame#TerminCard {
  background: #ffffff;
  border: 1px solid #83111111;      /* dünn + schwarz */
  border-radius: 4px;            /* runde Ecken */
}

QFrame#TerminCard:hover {
  background: #ffffff;
  border: 1px solid #000000;      /* hover: etwas “crisper” */
}


/* Text */
QLabel#CardTitle {
  background: transparent;
  color: #111111;
  font-weight: 600;
  font-size: 13px;
}

QLabel#CardSub {
  background: transparent;
  color: #666666;
  font-size: 11px;
}

/* Chips (klein, pill-shaped) */
QLabel[chip="true"] {
  background: #f5f5f5;
  border: 1px solid #d9d9d9;
  border-radius: 999px;
  padding: 2px 8px;
  color: #111111;
  font-size: 10px;
}

/* Optional: AP auffälliger */
QLabel#ChipAP {
  background: #111111;
  border: 1px solid #111111;
  color: white;
}
